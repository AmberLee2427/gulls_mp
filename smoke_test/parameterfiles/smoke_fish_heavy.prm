RUN_NAME=smoke_fish
OUTPUT_DIR=smoke_test/output/fish/
FINAL_DIR=smoke_test/output/fish/
EXECUTABLE=gullsFish

OBSERVATORY_DIR=smoke_test/assets/observatories/
OBSERVATORY_LIST=smoke.list

WEATHER_PROFILE_DIR=smoke_test/assets/weather/

STARFIELD_DIR=smoke_test/assets/starfields/
STARFIELD_LIST=smoke.starfields

SOURCE_DIR=smoke_test/assets/sources/
SOURCE_LIST=smoke.sources
SOURCE_COLOURS=0

LENS_DIR=smoke_test/assets/lenses/
LENS_LIST=smoke_heavy.lenses
LENS_COLOURS=0

PLANET_DIR=smoke_test/assets/planets/
PLANET_ROOT=smoke.planets.

RATES_FILE=smoke_test/assets/rates/smoke.rates

PRINCIPLE_OBSERVATORY=0
OUTPUT_LC=1
OUTPUT_IMAGES=1
PRETTY_PICS=1
PRETTY_PICS_DIMENSIONS=32
OUTPUT_ONERR=0
OUTPUT_ONDET=1
OUTPUT_ONALL=1
PARALLAX=1
LENS_LIGHT=1

SET_RANDOM_SEED_TO_CLOCK=0
RANDOM_SEED=12345
# Roman (-211) Horizons earliest ephemeris time per astroquery error message:
#   "No ephemeris for target 'Roman Space Telescope (spacecraft)' prior to A.D. 2026-OCT-30 07:05:25.0645 TD"
# Converted with astropy (scale=TDB):
#   JD(TDB) = 2461343.795428987, MJD(TDB) = 61343.295428987
# BAGLE parallax uses TDB internally (bagle/parallax.py: Time(mjd + 2400000.5, scale='tdb')).
# Set SIMULATION_ZERO_TIME (BJD_TDB) to a value safely AFTER this cutoff to allow strict Roman (-211) queries.
# Using +2.0 day margin to accommodate upstream BAGLE Horizons range padding (which may extend start times earlier).
# Previous value 2461345.0 (boundary+~1.2d) still triggered pre-boundary RANGE queries due to BAGLE's internal
# date truncation/padding. Advancing one additional day eliminates that risk without altering event physics.
SIMULATION_ZERO_TIME=2461346.0

SUBRUNSIZE=1

NFILTERS=32
AMIN=1.0001
LARGEPSFMAG=25.0
MIN_CHISQUARED=0.0
U0MAX=1.0

LC_GEN=1
LD_GAMMA=0.1
VBM_RELTOL=1.0e-6
VBM_ABSTOL=1.0e-4
LC_TIMEOUT=10.0

NUM_SIM_DAYS=200

REPEAT_SEQUENCE=0
OBS_GROUPS=(ALL)
OBS_GROUP_NAMES=smoke
ERROR_SCALING=0
MULTIPLE_SOURCES=0
MULTIPLE_LENSES=0

ASTROMETRY_ON=1
ASTROMETRIC_SYS_FLOOR=0.0
